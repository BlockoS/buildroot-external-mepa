From 0000000000000000000000000000000000000009 Mon Sep 17 00:00:00 2001
From: Vincent Cruz <mooz@blockos.org>
Date: Tue, 09 Sep 2026 15:53:00 +0200
Subject: [PATCH 9/9] mesa/demo/mepa_apps: enable LAN80xx PHY Dev Create + conf

Fix mesa-cmd `PHY Dev Create` and `PHY Dev conf` on the LAN80xx.
Without them mesa-cmd hangs indefinitely at DEFAULT reset and leaves the
SerDes uninitialised so the line-side link never comes up.

1) Clear the DFU strap bit between PRE and DEFAULT reset.  
   The LAN80xx boots into DFU mode if its DFU_STRAP hardware pin is high. 
   mepa_reset(PRE) mirrors hardware straps into STRAP_OVERRIDE_REG
   (MMD 0x1E addr 0x0201). If bit 0 stays set, DEFAULT reset enters
   fw_update_priv and hangs polling the mailbox forever waiting for
   firmware bytes.
   
2) Pick FI_10G_LAN media for the LAN80xx (0x80xx) family in the
   DEFAULT reset media_intf selection, not just the Malibu25G
   0x8250-mask. Falling through to MEDIA_IF_CU on LAN80xx leaves the
   line-side SerDes uninitialised.

3) Re-run POST reset at the tail of cli_cmd_phy_conf after a
   successful mepa_conf_set. phy_init runs POST *after* the per-port
   if_set + conf_set so the SerDes latches with the correct media
   configuration. mesa-cmd's Dev Create runs POST too early (before
   Attach / conf).

---
 mesa/demo/mepa_apps/phy_port_config.c | 26 +++++++++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

--- a/mesa/demo/mepa_apps/phy_port_config.c
+++ b/mesa/demo/mepa_apps/phy_port_config.c
@@ -131,9 +131,23 @@
         return MESA_RC_ERROR;
     }
     meba_phy_info_get(meba_phy_inst, port_no, &phy_info);
-    phy_reset.media_intf = ((phy_info.part_number & 0xfff0) != MALIBU_SPECIFIC_CHECK)
-                               ? MESA_PHY_MEDIA_IF_CU
-                               : MESA_PHY_MEDIA_IF_FI_10G_LAN;
+    /* LAN80xx: clear DFU strap (STRAP_OVERRIDE_REG.0) or DEFAULT reset hangs. */
+    if ((phy_info.part_number & 0xff00) == 0x8000) {
+        uint32_t strap = 0;
+        if (lan80xx_phy_csr_read(meba_phy_inst->phy_devices[port_no], port_no,
+                                 0x1EU, 0x0201U, &strap) == MEPA_RC_OK &&
+            (strap & 0x1U) != 0U) {
+            strap &= ~0x1U;
+            (void)lan80xx_phy_csr_write(meba_phy_inst->phy_devices[port_no], port_no,
+                                        0x1EU, 0x0201U, strap);
+        }
+    }
+    if ((phy_info.part_number & 0xfff0) == MALIBU_SPECIFIC_CHECK ||
+        (phy_info.part_number & 0xff00) == 0x8000) {
+        phy_reset.media_intf = MESA_PHY_MEDIA_IF_FI_10G_LAN;
+    } else {
+        phy_reset.media_intf = MESA_PHY_MEDIA_IF_CU;
+    }
     phy_reset.reset_point = MEPA_RESET_POINT_DEFAULT;
     if ((mepa_reset(meba_phy_inst->phy_devices[port_no], &phy_reset) != MESA_RC_OK)) {
         T_E("Default reset failed %d", port_no);
@@ -268,6 +282,16 @@
                            iport2uport(req->port_no), rc);
             } else {
                 cli_printf("conf applied on port %u\n", iport2uport(req->port_no));
+                /* Re-run POST reset so SerDes latches with the applied media. */
+                mepa_reset_param_t post_reset = {};
+                post_reset.reset_point = MEPA_RESET_POINT_POST;
+                post_reset.media_intf = (conf.speed == MESA_SPEED_10G ||
+                                         conf.speed == MESA_SPEED_25G)
+                                            ? MESA_PHY_MEDIA_IF_FI_10G_LAN
+                                            : MESA_PHY_MEDIA_IF_CU;
+                if (mepa_reset(dev, &post_reset) != MESA_RC_OK) {
+                    T_E("Post-conf POST reset failed on port %u", req->port_no);
+                }
             }
         file_close:
             free(buffer);
