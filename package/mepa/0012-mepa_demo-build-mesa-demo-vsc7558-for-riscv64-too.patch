From baac4def763ee9f153b45f2333d77dc4214a1556 Mon Sep 17 00:00:00 2001
From: Vincent Cruz <mooz@blockos.org>
Date: Mon, 29 Jun 2026 10:55:20 +0200
Subject: [PATCH 12/13] mepa_demo: build mesa-demo-vsc7558 for riscv64 too

Mirror the existing aarch64 branch into the CMAKE_SYSTEM_PROCESSOR ladder so the EDSx-flavoured app target also gets registered when the toolchain reports riscv64.

Buildroot's SDK toolchain sets CMAKE_SYSTEM_PROCESSOR to riscv64, which previously fell through to no APP_TARGET at all and produced no mesa-demo-* binary on cross-builds.  Adding this branch alone doesn't make the binary functional on a non-EDSx board; it just lets the build matrix cover riscv64.
---
 mepa_demo/CMakeLists.txt | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mepa_demo/CMakeLists.txt b/mepa_demo/CMakeLists.txt
index 0f34414..3908d7f 100644
--- a/mepa_demo/CMakeLists.txt
+++ b/mepa_demo/CMakeLists.txt
@@ -273,6 +273,8 @@ endmacro()
 if (CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
     APP_TARGET(NAME app_vsc7558_edsx         MESA vsc7558          MEBA meba_edsx          APP_TARGET_DEFINES -DMEPA_HAS_LAN80XX -DMEPA_HAS_VTSS -DMEPA_DEMO_EDSx)
     IMG_TARGET(NAME arm64_vsc7558_edsx       TYPE ext4             APP app_vsc7558_edsx    MACHINE fireant)
+elseif (CMAKE_SYSTEM_PROCESSOR STREQUAL "riscv64")
+    APP_TARGET(NAME app_vsc7558_edsx         MESA vsc7558          MEBA meba_edsx          APP_TARGET_DEFINES -DMEPA_HAS_LAN80XX -DMEPA_HAS_VTSS -DMEPA_DEMO_EDSx)
 elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "armv7l")
     APP_TARGET(NAME app_lan966x            MESA lan966x            MEBA meba_eds2          APP_TARGET_DEFINES -DMEPA_DEMO_EDS2)
     IMG_TARGET(NAME armv7_lan966x          TYPE ext4               APP app_lan966x         MACHINE lan966x)
