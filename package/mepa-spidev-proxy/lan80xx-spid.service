[Unit]
Description=LAN80xx SPI proxy daemon (arbitrates /dev/spidev0.0)
Documentation=https://github.com/vjardin/mepa-spidev-proxy
Wants=dev-spidev0.0.device
After=dev-spidev0.0.device local-fs.target
Before=network-pre.target

# TS FIFO drain by interrupt: add -i auto|only [-g <line>[:a|:b]] [-w <ms>] to
# ExecStart (the SysV script reads TSFIFO_IRQ_* from /etc/default/lan80xx-spid)
[Service]
Type=simple
ExecStart=/usr/bin/lan80xx-spid -d /dev/spidev0.0 -f 8000000
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
